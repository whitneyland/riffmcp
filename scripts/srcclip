#!/usr/bin/env zsh
# Summarizes Swift source for quick sharing:
# - Walks to the Git repo root, finds all `.swift` files outside any *Tests* folders plus build/Pods/Carthage/DerivedData.
# - Concatenates them (sorted), strips Swift comments/empty lines, and writes to combined.swift in the invocation directory.
# - Copies the combined file to the clipboard when pbcopy/xclip is available.

set -euo pipefail

VERSION="1.02"

# Remember where the script was invoked
CALLER_DIR=$PWD

# Flags
FULLCODE=false

usage() {
  cat <<'EOF'
Usage: srcclip [--fullcode]
  --fullcode  Keep comments and include *Tests* sources.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    fullcode|--fullcode)
      FULLCODE=true
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1"
      usage
      exit 1
      ;;
  esac
done

# Find the Git project root
PROJECT_ROOT=$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null)
if [[ -z "$PROJECT_ROOT" ]]; then
  echo "❌ Not inside a Git repo. Aborting."
  exit 1
fi

cd "$PROJECT_ROOT"
echo "🧩 srcclip v$VERSION"
echo "📁 Using project root: $PROJECT_ROOT"

# Configuration
OUT_FILE="$CALLER_DIR/combined.swift"
OUT_FILE_REL="${OUT_FILE#$PROJECT_ROOT/}"
OUT_FILE_PATH="./${OUT_FILE_REL#./}"

echo "🔍 Finding Swift files..."

FIND_FILTERS=(
  -type f
  -name '*.swift'
  -not -path "$OUT_FILE_PATH"
  -not -path '*/Pods/*'
  -not -path '*/Carthage/*'
  -not -path '*/DerivedData/*'
  -not -path '*/build/*'
  -not -path '*/.build/*'
)

if [[ "$FULLCODE" == false ]]; then
  FIND_FILTERS+=( -not -path '*/*Tests*/*' )
fi

# Find and combine Swift files, optionally strip comments
{
    find . "${FIND_FILTERS[@]}" -print0 \
    | sort -z \
    | while IFS= read -r -d '' file; do
        echo "// $file"
        if [[ "$FULLCODE" == true ]]; then
            cat "$file"
        else
            cat "$file" | sed -E '
                # Remove single-line comments
                s@//.*$@@

                # Remove multi-line comments
                :a
                /\/\*/ {
                    /\*\//! {
                        N
                        ba
                    }
                    s@/\*.*\*/@@
                }
            ' | awk '
                /^[[:space:]]*$/ { next }
                { print }
            '
        fi
        echo ""
    done
} > "$OUT_FILE"

LINE_COUNT=$(wc -l < "$OUT_FILE")
FILE_COUNT=$(find . "${FIND_FILTERS[@]}" | wc -l)

echo "✅ Combined $FILE_COUNT Swift files"
echo "📄 Wrote $LINE_COUNT lines to $OUT_FILE"

# Copy to clipboard
if command -v pbcopy >/dev/null 2>&1; then
    cat "$OUT_FILE" | pbcopy
    echo "📋 Copied to clipboard"
elif command -v xclip >/dev/null 2>&1; then
    cat "$OUT_FILE" | xclip -selection clipboard
    echo "📋 Copied to clipboard"
else
    echo "⚠️  Clipboard utility not found (pbcopy/xclip)"
fi

echo "🎉 Done!"
